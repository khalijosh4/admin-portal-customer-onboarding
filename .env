# ------------------------------------------------------------------
# Fortune Sacco Admin Review Portal — configuration
# ------------------------------------------------------------------

# CBS read — the widget/CBS site that holds applications.
# This is usually a private network endpoint; if it is not reachable, the app
# falls back to the local onboarding backend instead of failing the dashboard.
VITE_CBS_READ_BASE=http://10.10.102.132:8087
# CBS submit — where approve/push-to-core is delivered.
VITE_CBS_SUBMIT_BASE=http://10.10.102.132:8087

# Optional Bearer token for the CBS/Spring API.
# Leave EMPTY when the backend whitelists the endpoints (permitAll).
# Set it only if the backend requires `Authorization: Bearer <token>`.
VITE_CBS_TOKEN=

# Onboarding backend — admin auth, user mgmt, profile, notifications,
# membership form, reject.
VITE_ONBOARDING_BASE=http://localhost:5000/api