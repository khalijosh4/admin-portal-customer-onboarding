# ------------------------------------------------------------------
# Fortune Sacco Admin Review Portal — configuration
# ------------------------------------------------------------------
# The portal talks to two CBS "core submission" API endpoints that store
# applications entered via the standalone widget site:
#
#   READ:   GET  {API_READ_BASE}/api/applications/all          -> all applications
#           GET  {API_READ_BASE}/api/applications/{id}         -> one application
#   SUBMIT: POST {API_SUBMIT_BASE}/api/applications/{id}/submit-to-core -> push to core
#
# Defaults are the hosts provided. Override here or via your shell.

VITE_API_READ_BASE=http://10.10.1.170:8087
VITE_API_SUBMIT_BASE=http://localhost:8087

# Local admin-login gate (the CBS API has no authentication of its own).
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123